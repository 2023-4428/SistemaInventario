<Project>
  <!--
    Configuración común a todos los proyectos de la solución.
    Para cambiar de versión de .NET (por ejemplo a net8.0) basta con editar MarcoDotNet.
  -->
  <PropertyGroup>
    <MarcoDotNet>net10.0</MarcoDotNet>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Product>Sistema de Inventario</Product>
  </PropertyGroup>
</Project>
